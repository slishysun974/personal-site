---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagBadge from "../../components/TagBadge.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, date, tags, techStack, role, repoUrl, demoUrl } = project.data;
const { Content } = await project.render();
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl">
    <header class="mb-8">
      <time class="text-sm text-gray-500 dark:text-gray-400">
        {date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
      </time>
      <h1 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">{description}</p>
    </header>

    <!-- Metadata -->
    <div class="mb-8 flex flex-wrap items-center gap-4 rounded-lg border border-gray-200 dark:border-gray-800 p-4 text-sm">
      {role && (
        <div>
          <span class="text-gray-500 dark:text-gray-400">角色：</span>
          <span class="text-gray-900 dark:text-white">{role}</span>
        </div>
      )}
      {techStack && techStack.length > 0 && (
        <div class="flex flex-wrap items-center gap-1">
          <span class="text-gray-500 dark:text-gray-400">技术栈：</span>
          {techStack.map((tech) => <TagBadge label={tech} />)}
        </div>
      )}
      <div class="flex gap-3">
        {repoUrl && (
          <a href={repoUrl} class="text-blue-600 no-underline hover:underline dark:text-blue-400">源代码 →</a>
        )}
        {demoUrl && (
          <a href={demoUrl} class="text-blue-600 no-underline hover:underline dark:text-blue-400">在线演示 →</a>
        )}
      </div>
    </div>

    <!-- Content -->
    <div class="prose prose-gray dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
