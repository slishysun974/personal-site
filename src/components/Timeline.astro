---
// Placeholder: full CSS-only timeline in Sprint 5
import type { CollectionEntry } from "astro:content";

type Props = {
  items: CollectionEntry<"competitions">[];
};

const { items } = Astro.props;
---

<div class="relative">
  <div class="absolute left-4 top-0 h-full w-0.5 bg-gray-200 dark:bg-gray-700 sm:left-1/2 sm:-translate-x-px" />
  <ul class="space-y-8">
    {items.map((item) => {
      const { title, date, description, award } = item.data;
      return (
        <li class="relative pl-10 sm:pl-0">
          <div class="absolute left-0 top-1 h-8 w-8 rounded-full border-2 border-blue-500 bg-white dark:bg-gray-900 sm:left-1/2 sm:-translate-x-1/2" />
          <div class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 sm:w-[calc(50%-2rem)]">
            <time class="text-xs text-gray-500 dark:text-gray-400">{date.getFullYear()}-{String(date.getMonth() + 1).padStart(2, "0")}</time>
            <h3 class="mt-1 font-semibold text-gray-900 dark:text-white">{title}</h3>
            {award && (
              <span class="mt-1 inline-block rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300">
                {award}
              </span>
            )}
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{description}</p>
          </div>
        </li>
      );
    })}
  </ul>
</div>
