---
import TagBadge from "./TagBadge.astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  course: CollectionEntry<"courses">;
};

const { course } = Astro.props;
const { title, description, tags, grade, semester } = course.data;
---

<article class="rounded-lg border border-gray-200 dark:border-gray-800 p-6 hover:shadow-lg transition-shadow">
  <div class="flex items-start justify-between">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{title}</h3>
    {grade && (
      <span class="ml-2 shrink-0 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900/40 dark:text-green-300">
        {grade}
      </span>
    )}
  </div>
  {semester && (
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{semester}</p>
  )}
  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 line-clamp-3">{description}</p>
  {
    tags && tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1">
        {tags.map((tag) => <TagBadge label={tag} />)}
      </div>
    )
  }
</article>
